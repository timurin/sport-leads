# Copy to `.env` in the repository root for Docker Compose and local backend.
# Do not commit real secrets.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sport_leads
POSTGRES_USER=sport_leads
POSTGRES_PASSWORD=change_me_local_only

# Optional: override SQLAlchemy URL (otherwise built from POSTGRES_* above)
# DATABASE_URL=postgresql+psycopg2://sport_leads:change_me_local_only@localhost:5432/sport_leads

TZ=Europe/Moscow

# API logging (roadmap 0.3.2)
LOG_LEVEL=INFO
LOG_FORMAT=text
# LOG_FORMAT=json

# Auth (ADR-023 / 17.1.1.2) — bootstrap creates first PlatformUser when table empty
# AUTH_BOOTSTRAP_LOGIN=admin
# AUTH_BOOTSTRAP_PASSWORD=change_me_local_only
# AUTH_BOOTSTRAP_DISPLAY_NAME=Администратор
AUTH_SESSION_TTL_HOURS=12
AUTH_SESSION_MAX_HOURS=24
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
SPORT_LEADS_CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
# LAN access (v1.00 0.3): add http://<host-LAN-IP>:3001 to CORS, e.g.
# SPORT_LEADS_CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001,http://192.168.1.10:3001
# Start with: powershell -File scripts/dev-servers.ps1 -Action start -Lan
# Optional browser API base (client components on another LAN device):
# NEXT_PUBLIC_SPORT_LEADS_API_URL=http://192.168.1.10:8000
# Server RSC may keep SPORT_LEADS_API_URL=http://127.0.0.1:8000 when FE+BE run on the same host.
# SPORT_LEADS_API_URL=http://127.0.0.1:8000
# Threat: -Lan binds 0.0.0.0 — trusted LAN only; ≠ public internet / production Caddy. Port 3000 out of scope.

# pgAdmin (Docker Compose only — local `compose.yaml`, not production)
PGADMIN_EMAIL=admin@example.local
PGADMIN_PASSWORD=change_me_local_only
PGADMIN_PORT=5050

# Production (17.2.1) — copy `.env.production.example` → `.env.production` on the VPS.
# See `docs/ops/production-17-2-1.md` and `compose.prod.yaml`.
# SPORT_LEADS_DOMAIN=erp.example.com
