# Production secrets for `compose.prod.yaml` (17.2.1 / Stage 0.5).
# Copy to `.env.production` on the VPS. Do not commit real values.
# `.env.production` is gitignored via `.env.*`.

# --- Public edge (only user origin) ---
SPORT_LEADS_DOMAIN=sport-lead.ru
PUBLIC_APP_ORIGIN=https://sport-lead.ru
TZ=Europe/Moscow

# --- Postgres (compose service name; published to host 127.0.0.1:5432 for SSH tunnel) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sport_leads
POSTGRES_USER=sport_leads
POSTGRES_PASSWORD=change_me_strong_production_password

# --- Auth (ADR-023) ---
AUTH_BOOTSTRAP_LOGIN=admin
AUTH_BOOTSTRAP_PASSWORD=change_me_strong_bootstrap_password
AUTH_BOOTSTRAP_DISPLAY_NAME=Администратор
AUTH_SESSION_TTL_HOURS=12
AUTH_SESSION_MAX_HOURS=24
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# Same-origin via Caddy→Next; leave empty or set https://sport-lead.ru if needed
SPORT_LEADS_CORS_ORIGINS=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
