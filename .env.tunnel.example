# Owner-only: local uvicorn against VPS Postgres via SSH tunnel (Stage 0.5 / ADR-032).
# Copy to `.env.tunnel` in the repo root. Do not commit real values.
# `.env.tunnel` is gitignored via `.env.*`.
#
# 1. powershell -File scripts/vps-db-tunnel.ps1 -SshHost YOUR_VPS_IP
# 2. Use the SAME POSTGRES_PASSWORD as VPS `.env.production`
# 3. Point uvicorn at this file. Never pytest / check_project.py / alembic against :5433.
# Local Docker Postgres for tests stays on POSTGRES_PORT=5432 in `.env`.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=sport_leads
POSTGRES_USER=sport_leads
POSTGRES_PASSWORD=change_me_same_as_vps_env_production

TZ=Europe/Moscow
LOG_LEVEL=INFO
LOG_FORMAT=text

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
SPORT_LEADS_CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
