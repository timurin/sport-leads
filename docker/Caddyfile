# Sport-Lead production edge (17.2.1.2 / 17.2.2.2 / Stage 0.5.6.1).
# Public hostname: sport-lead.ru (SPORT_LEADS_DOMAIN).
# Caddy obtains/renews Let's Encrypt when the A-record points at this host
# and ports 80/443 are reachable.
# www DNS exists (A → same VPS). Redirect to apex so Let's Encrypt covers both names.

www.{$SPORT_LEADS_DOMAIN:sport-lead.ru} {
	redir https://{$SPORT_LEADS_DOMAIN:sport-lead.ru}{uri} permanent
}

{$SPORT_LEADS_DOMAIN:sport-lead.ru} {
	encode gzip

	# Edge liveness (Caddy process)
	handle /healthz {
		respond "ok" 200
	}

	# API liveness / readiness for uptime monitors (17.2.2.2)
	handle /health {
		reverse_proxy api:8000
	}
	handle /health/ready {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
