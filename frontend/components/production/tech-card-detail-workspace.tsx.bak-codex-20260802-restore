    options?: { skipRefresh?: boolean },
  ) => {
    setBusy(true);
    setActionError(null);
    try {
      const result = await action();
      if (!result.ok) {
        setActionError(result.message ?? "РћС€РёР±РєР° РґРµР№СЃС‚РІРёСЏ");
